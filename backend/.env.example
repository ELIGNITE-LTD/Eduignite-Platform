# =============================================================================
# EduIgnite Backend – AWS EC2 / RDS Production Environment
# Copy this file to .env on the EC2 host and replace every placeholder value.
# Never commit a populated .env file.
# =============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
DJANGO_ENV=production
NODE_ENV=production
DJANGO_SETTINGS_MODULE=config.settings.production
ENVIRONMENT=production

# ── Django core ───────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret-key
DEBUG=False
ALLOWED_HOSTS=api.eduignite.online,eduignite.com,www.eduignite.com,<EC2_PUBLIC_IP>

# ── PostgreSQL only: AWS RDS ──────────────────────────────────────────────────
# SQLite and database fallbacks are intentionally unsupported.
DB_NAME=replace-with-rds-database-name
DB_USER=replace-with-rds-username
DB_PASSWORD=replace-with-rds-password
DB_HOST=eduignite-db.covciwuwadhr.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ── Frontend, CORS, and CSRF ──────────────────────────────────────────────────
FRONTEND_URL=https://eduignite.online
FRONTEND_URLS=https://eduignite.online,https://www.eduignite.online,https://admin.eduignite.online,https://dashboard.eduignite.online
CORS_ALLOWED_ORIGINS=https://eduignite.com,https://www.eduignite.com,https://admin.eduignite.com,https://dashboard.eduignite.com
CSRF_TRUSTED_ORIGINS=https://eduignite.com,https://www.eduignite.com,https://admin.eduignite.com,https://dashboard.eduignite.com,https://api.eduignite.online

# ── Security ──────────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ── Redis and Celery ──────────────────────────────────────────────────────────
# Set these when Redis is available. Without Redis, selected async features run in eager/in-memory mode.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_EAGER_PROPAGATES=True

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-email-user
EMAIL_HOST_PASSWORD=replace-with-email-app-password
DEFAULT_FROM_EMAIL=EduIgnite <noreply@eduignite.com>
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_FROM_ADDRESS=no-reply@eduignite.online
EMAIL_FROM_NAME=EduIgnite
EMAIL_PROVIDER_TIMEOUT_SECONDS=12
SERVER_EMAIL=noreply@eduignite.com

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=replace-with-firebase-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=replace-with-firebase-client-email
FIREBASE_CLIENT_ID=replace-with-firebase-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=replace-with-firebase-client-cert-url

# ── AI Provider ───────────────────────────────────────────────────────────────
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=35
GROQ_MAX_RETRIES=1
GROQ_FAST_API_KEY=replace-with-secondary-groq-api-key
GROQ_EXAM_API_KEY=
GROQ_CAREER_API_KEY=
GROQ_FAST_MODEL=llama-3.3-70b-versatile
GROQ_EXAM_MODEL=llama-3.3-70b-versatile
GROQ_CAREER_MODEL=llama-3.3-70b-versatile
GROQ_FAST_TIMEOUT_SECONDS=18
GROQ_FAST_MAX_RETRIES=0
GROQ_CAREER_TIMEOUT_SECONDS=18
GROQ_CAREER_MAX_RETRIES=0
AI_INLINE_FAST_FEATURES=ai_exam_generation,career_orientation
# AI credits: the day free credits refresh on. Prices and the allowance are
# set from the executive dashboard, not here.
AI_CREDITS_TIMEZONE=Africa/Douala
# Questions sent as photos: the model that reads them, and the limits.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_CHAT_MAX_IMAGES=3
# EduIgnite AI on Telegram. Token from @BotFather; the secret is any long random
# string. After setting them, run: python manage.py telegram_setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
BOTS_PUBLIC_API_URL=https://api.eduignite.online
# Website that draws answers into PDFs (defaults to FRONTEND_URL).
BOT_RENDER_BASE_URL=
AI_EXAM_GENERATION_DAILY_LIMIT=50
AI_CAREER_REPORT_DAILY_LIMIT=10
AI_SKILL_GAP_DAILY_LIMIT=20
WEASYPRINT_BASEURL=http://localhost:8000
CELERY_TASK_ALWAYS_EAGER=false
CELERY_BROKER_CONNECTION_TIMEOUT=2
CELERY_TASK_PUBLISH_RETRY=false
CELERY_TASK_PUBLISH_MAX_RETRIES=1
AI_ALLOW_SYNC_FALLBACK=false

# ── AWS S3 media storage, optional ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=replace-with-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# ── Error tracking, optional ──────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Self-hosted LibreTranslate. No paid API key is required.
LIBRETRANSLATE_URL=http://localhost:5000

# ── CamPay mobile-money gateway (MTN / Orange Money) ──────────────────────────
# Get these from the CamPay dashboard (https://www.campay.net). Never commit real values.
CAMPAY_ENVIRONMENT=PROD
CAMPAY_APP_ID=replace-with-campay-app-id
CAMPAY_USERNAME=replace-with-campay-app-username
CAMPAY_PASSWORD=replace-with-campay-app-password
CAMPAY_ACCESS_TOKEN=replace-with-campay-permanent-access-token
CAMPAY_WEBHOOK_KEY=replace-with-campay-webhook-key
CAMPAY_WEBHOOK_URL=https://eduignite.online/api/v1/fees/campay/webhook/
CAMPAY_DEFAULT_CURRENCY=XAF

# ── EduIgnite Offline licensing (ECDSA P-256 signing key) ─────────────────────
# PRODUCTION key must be provisioned via SSM Parameter Store
# /eduignite/prod/offline-licensing/private-key, see backend README. Never put
# a real key in this file — it is tracked in git.
#
# For local dev/testing, generate a keypair (ECDSA P-256 / secp256r1, PKCS8
# PEM) and put BOTH values in your own gitignored `.env`, not here. The
# private half must exactly match the public half already checked into the
# desktop app at apps/offline-desktop/src/licensing/public-key.pem — that
# file is the source of truth for the shared dev pair (its matching private
# half lives at apps/offline-desktop/DEV-PRIVATE-KEY-DO-NOT-SHIP.pem, which
# is itself gitignored there — copy its value into your local backend `.env`
# rather than regenerating a new keypair, or the desktop app won't be able to
# verify certificates this backend signs).
OFFLINE_LICENSING_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Public counterpart (safe to commit in principle — it's public — but left as
# a placeholder here too so this file never implies a real pair is in use).
OFFLINE_LICENSING_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# ── App version CI updates ────────────────────────────────────────────────────
# Shared secret CI uses to POST /api/v1/platform/app-versions/{app_key}/ at the
# end of a release workflow (mobile.yml, desktop.yml, offline-desktop.yml,
# offline-companion.yml). Set the SAME value as the GitHub Actions repo secret
# CI_VERSION_UPDATE_TOKEN. Never a real secret in this committed file — put your
# own dev value in a gitignored local `.env` only.
CI_VERSION_UPDATE_TOKEN=change-me-in-local-env-only
