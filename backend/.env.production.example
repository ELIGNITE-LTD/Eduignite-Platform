# EduIgnite self-hosted production env (template).
# The real .env is generated on the server with random secrets - never commit it.

DJANGO_SETTINGS_MODULE=config.settings.production
ENVIRONMENT=production
DEBUG=False

# --- Secrets (generated on the server) ---
DJANGO_SECRET_KEY=CHANGE_ME

# --- Database (Postgres container on the private network) ---
DB_NAME=eduignite
DB_USER=eduignite
DB_PASSWORD=CHANGE_ME
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable
# Postgres image reads these (same values as DB_*)
POSTGRES_DB=eduignite
POSTGRES_USER=eduignite
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis / Celery (Redis container on the private network) ---
REDIS_URL=redis://redis:6379/1
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Hosts / CORS / CSRF ---
ALLOWED_HOSTS=api.eduignite.online,eduignite.online,www.eduignite.online,169.58.48.112,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://eduignite.online,https://www.eduignite.online,https://api.eduignite.online
CSRF_TRUSTED_ORIGINS=https://eduignite.online,https://www.eduignite.online,https://api.eduignite.online
# Caddy/Cloudflare terminate TLS; keep this False until HTTPS is fully live, then True.
SECURE_SSL_REDIRECT=False

# --- Media: local disk for now (leave AWS_S3_CUSTOM_DOMAIN empty => local /media). ---
# To move to Cloudflare R2 / S3 later, set these and AWS_S3_CUSTOM_DOMAIN.
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_CUSTOM_DOMAIN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=auto

# --- External services (fill when available / recovered from AWS SSM) ---
# Email (Brevo)
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=EduIgnite <no-reply@eduignite.online>
EMAIL_FROM_ADDRESS=no-reply@eduignite.online
EMAIL_FROM_NAME=EduIgnite
# Payments (Fapshi live)
FAPSHI_API_USER=
FAPSHI_API_KEY=
# AI (Gemini — primary). Get a key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# AI (Groq — fallback, only used if GEMINI_API_KEY is empty)
GROQ_API_KEY=
# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=
# Installer version-update token (optional)
CI_VERSION_UPDATE_TOKEN=
