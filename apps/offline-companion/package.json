{
  "name": "eduignite-offline-companion",
  "version": "1.0.0",
  "private": true,
  "description": "EduIgnite Companion — standalone Android app for a school technician to activate/renew an EduIgnite Offline desktop license via QR code, without installing the full EduIgnite Mobile app.",
  "author": "EduIgnite",
  "scripts": {
    "dev": "next dev -p 9003",
    "build": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync": "npm run build && npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.3",
    "@eduignite/capacitor-apk-installer": "file:../../packages/capacitor-apk-installer",
    "axios": "^1.7.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.475.0",
    "next": "15.5.25",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.4"
  }
}
