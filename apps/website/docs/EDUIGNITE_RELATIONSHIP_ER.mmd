    USER ||--o{ SCHOOL : administers
    USER ||--o{ ASSIGNMENT : creates
    USER ||--o{ SUBMISSION : submits

    SCHOOL ||--o{ SCHOOL_CLASS : owns
    SCHOOL ||--o{ STUDENT : enrolls
    SCHOOL ||--o{ USER : employs_or_hosts
    SCHOOL ||--o{ SUBJECT : offers
    SCHOOL ||--o{ APP_STORE_ITEM : optionally_scopes

    SCHOOL_CLASS ||--o{ STUDENT : contains
    SCHOOL_CLASS ||--o{ SUBJECT : teaches
    SCHOOL_CLASS ||--o{ ASSIGNMENT : receives
    SCHOOL_CLASS ||--o{ ATTENDANCE_RECORD : tracks
    SCHOOL_CLASS ||--o{ GRADE_RECORD : records

    STUDENT ||--o{ PARENT_STUDENT_LINK : linked_to
    STUDENT ||--o{ SUBMISSION : submits
    STUDENT ||--o{ ATTENDANCE_RECORD : has
    STUDENT ||--o{ GRADE_RECORD : earns
    STUDENT ||--o{ FEE_RECORD : billed
    STUDENT ||--o{ LIBRARY_REQUEST : requests

