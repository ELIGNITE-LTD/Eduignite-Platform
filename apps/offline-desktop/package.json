{
  "name": "eduignite-offline-desktop",
  "version": "1.0.11",
  "private": true,
  "description": "EduIgnite Offline — offline-first Electron desktop app for schools with poor/no internet connectivity.",
  "author": "EduIgnite",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "electron:dev": "vite",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jsqr": "^1.4.0",
    "pdfmake": "^0.2.20",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^6.28.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20",
    "@types/pdfmake": "^0.2.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  }
}
